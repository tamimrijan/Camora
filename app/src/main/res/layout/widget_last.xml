<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_round"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/last_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_last_label"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/last_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="28dp">
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/camora_logo" />
        <TextView
            android:id="@+id/last_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_last_label"
            android:textColor="#FFD4D4DA"
            android:textSize="13sp" />
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:contentDescription="@null"
        android:src="@drawable/widget_scrim"
        android:scaleType="fitXY" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="16dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
    <ImageView
        android:id="@+id/last_shutter"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:contentDescription="@string/widget_quick_label"
        android:src="@drawable/widget_shutter" />
</FrameLayout>