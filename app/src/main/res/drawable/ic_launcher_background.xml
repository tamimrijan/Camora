<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: same diagonal gradient as camora_logo, mapped onto the
     72dp visible area (18..90) of the 108dp adaptive-icon canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#FF1B5FC7"
                android:endColor="#FF0B1E44" />
        </aapt:attr>
    </path>
</vector>
